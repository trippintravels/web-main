# Enquiry notifier — the Cloudflare Worker that relays form submissions to WhatsApp.
#
# Copy to .env for local development. .env is gitignored; these two must also be
# added as GitHub Actions secrets (Settings → Secrets and variables → Actions),
# because Vite inlines VITE_* values at BUILD time, not at runtime.
#
# Leave them unset and the form still works — it tells people to email instead
# of failing. That's the expected state until the Worker is deployed.

VITE_NOTIFIER_URL=https://your-worker.workers.dev/enquiry
VITE_NOTIFIER_KEY=some-random-string

# WARNING: VITE_NOTIFIER_KEY ships inside the public JS bundle — anyone can read
# it. It only deters casual bots. Real secrets (the WhatsApp token, phone-number
# IDs) belong in the Worker's own environment and must never appear here.
